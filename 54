/*54. Criar uma função que calcule e retorne o número de combinações de n elementos p a p. A fórmula de
combinação é a seguinte:
)!(!
!
pnp
n Cn
p − =
Caso não seja capaz de calcular tal combinação a função deve retornar -1. Um algoritmo para testar tal
função também deve ser escrito.*/

#include <stdio.h>

// Função auxiliar: calcula o fatorial
int fatorial(int n) {
    if (n < 0) return -1;
    int fat = 1;
    for (int i = 1; i <= n; i++) {
        fat *= i;
    }
    return fat;
}

// Função principal: calcula a Combinação
int combinacao(int n, int p) {
    // Validação: n e p não podem ser negativos e p não pode ser maior que n
    if (n < 0 || p < 0 || p > n) {
        return -1;
    }

    // Aplica a fórmula: n! / (p! * (n - p)!)
    return fatorial(n) / (fatorial(p) * fatorial(n - p));
}

// Algoritmo de teste (main)
int main() {
    int n, p;

    printf("Digite o valor de n e p: ");
    scanf("%d %d", &n, &p);

    int resultado = combinacao(n, p);

    if (resultado == -1) {
        printf("Nao foi possivel calcular a combinacao!\n");
    } else {
        printf("Combinacao C(%d, %d) = %d\n", n, p, resultado);
    }

    return 0;
}
