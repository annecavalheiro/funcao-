/* 114. Faça uma função que receba, por parâmetro, uma matriz A(12,12) e retorne a média aritmética dos
elementos abaixo da diagonal principal. */

#include <stdio.h>

// Funcao que recebe a matriz A(12,12) de reais por parametro
// e retorna a media aritmetica dos elementos abaixo da diagonal principal
float mediaAbaixoDiagonalPrincipal(float A[12][12]) {
    float soma = 0.0;
    int contador = 0;

    // Os elementos abaixo da diagonal principal sao aqueles onde i > j
    for (int i = 1; i < 12; i++) {
        for (int j = 0; j < i; j++) {
            soma += A[i][j];
            contador++;
        }
    }

    if (contador > 0) {
        return soma / contador;
    }
    
    return 0.0;
}

int main() {
    float A[12][12];

    // Preenchimento de exemplo para testes
    float valor = 1.0;
    for (int i = 0; i < 12; i++) {
        for (int j = 0; j < 12; j++) {
            A[i][j] = valor++;
        }
    }

    // Chama a funcao para calcular a media
    float media = mediaAbaixoDiagonalPrincipal(A);

    // Saida: exibe a media calculada
    printf("Media aritmetica dos elementos abaixo da diagonal principal: %.2f\n", media);

    return 0;
}
