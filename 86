/* 86. Faça um procedimento que recebe, por parâmetro, um vetor A(50) de reais e retorna-o ordenado em
ordem crescente. */

#include <stdio.h>

// Procedimento que recebe o vetor A por parametro e o ordena em ordem crescente (Bubble Sort)
void ordenarVetor(float A[]) {
    float aux;

    // Processamento: compara os elementos vizinhos e realiza a troca
    for (int i = 0; i < 50; i++) {
        for (int j = 0; j < 49 - i; j++) {
            if (A[j] > A[j + 1]) {
                // Troca os elementos de posicao
                aux = A[j];
                A[j] = A[j + 1];
                A[j + 1] = aux;
            }
        }
    }
}

int main() {
    // Entrada: vetor A com 50 numeros reais
    float A[50] = {
        50.5, 49.0, 48.2, 47.1, 46.8, 45.3, 44.9, 43.0, 42.1, 41.5,
        40.0, 39.4, 38.2, 37.9, 36.1, 35.0, 34.3, 33.7, 32.2, 31.0,
        30.5, 29.8, 28.1, 27.4, 26.0, 25.9, 24.2, 23.1, 22.0, 21.5,
        20.1, 19.3, 18.0, 17.6, 16.2, 15.0, 14.8, 13.1, 12.0, 11.4,
        10.0, 9.5,  8.2,  7.1,  6.0,  5.3,  4.9,  3.0,  2.1,  1.5
    };

    // Chama o procedimento para ordenar o vetor A
    ordenarVetor(A);

    // Saida: exibe o vetor A ordenado em ordem crescente
    printf("Vetor A ordenado em ordem crescente:\n");
    for (int i = 0; i < 50; i++) {
        printf("%.1f ", A[i]);
    }
    printf("\n");

    return 0;
}
