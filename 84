/* 84. Faça uma função que recebe um vetor X(20) de reais , por parâmetro, e retorna a soma dos elementos
de X.*/

#include <stdio.h>

// Funcao que recebe o vetor X de 20 numeros reais e retorna a soma dos elementos
float somarElementos(float X[]) {
    float soma = 0.0;

    // Processamento: acumula a soma de cada elemento real do vetor
    for (int i = 0; i < 20; i++) {
        soma = soma + X[i];
    }

    return soma; // Retorna a soma total
}

int main() {
    // Entrada: vetor X com 20 elementos do tipo real (float)
    float X[20] = {
        1.5, 2.0, 3.5, 4.0, 5.5, 6.0, 7.5, 8.0, 9.5, 10.0,
        1.0, 2.5, 3.0, 4.5, 5.0, 6.5, 7.0, 8.5, 9.0, 10.5
    };

    // Chama a funcao para calcular a soma
    float resultado = somarElementos(X);

    // Saida: exibe o resultado da soma dos elementos
    printf("Soma de todos os elementos do vetor: %.2f\n", resultado);

    return 0;
}
