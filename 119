/* 119. Faça uma função que receba, por parâmetro, uma matriz A(12,12) e retorna o produto dos elementos
acima da diagonal principal e da diagonal secundária. */

#include <stdio.h>

// Funcao que recebe a matriz A(12,12) e retorna o produto dos elementos
// que estao simultaneamente acima da diagonal principal e da secundaria (regiao superior)
double produtoAcimaDiagonais(double A[12][12]) {
    double produto = 1.0;
    int possuiElementos = 0;

    // Condicoes para estar acima de ambas as diagonais:
    // 1. Acima da diagonal principal: i < j
    // 2. Acima da diagonal secundaria: i + j < 11 (dimensao - 1)
    for (int i = 0; i < 12; i++) {
        for (int j = 0; j < 12; j++) {
            if (i < j && (i + j) < 11) {
                produto *= A[i][j];
                possuiElementos = 1;
            }
        }
    }

    return possuiElementos ? produto : 0.0;
}

int main() {
    double A[12][12];

    // Preenchimento de exemplo para testes (preenchendo com 1.5)
    for (int i = 0; i < 12; i++) {
        for (int j = 0; j < 12; j++) {
            A[i][j] = 1.5;
        }
    }

    // Chama a funcao para calcular o produto
    double resultado = produtoAcimaDiagonais(A);

    // Saida: exibe o produto calculado
    printf("Produto dos elementos acima das duas diagonais: %.2lf\n", resultado);

    return 0;
}
