//100. Faça uma função que recebe, por parâmetro, uma matriz A(6,6) e retorna a soma dos elementos da
//sua diagonal principal e da sua diagonal secundária.

#include <stdio.h>

// Funcao que recebe a matriz A(6,6) por parametro e retorna a soma
// dos elementos da diagonal principal e da diagonal secundaria
int somarDiagonais(int A[6][6]) {
    int soma = 0;

    for (int i = 0; i < 6; i++) {
        // Elemento da diagonal principal: A[i][i]
        soma += A[i][i];

        // Elemento da diagonal secundaria: A[i][5 - i]
        soma += A[i][5 - i];
    }

    return soma;
}

int main() {
    int A[6][6];

    // Entrada: o usuario preenche a matriz 6x6
    printf("Digite os elementos da matriz 6x6:\n");
    for (int i = 0; i < 6; i++) {
        for (int j = 0; j < 6; j++) {
            printf("Elemento [%d][%d]: ", i, j);
            scanf("%d", &A[i][j]);
        }
    }

    // Chama a funcao para calcular a soma das diagonais
    int resultado = somarDiagonais(A);

    // Saida: exibe a soma calculada
    printf("\nSoma dos elementos das diagonais principal e secundaria: %d\n", resultado);

    return 0;
}
