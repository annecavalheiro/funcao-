/*56. Criar uma função que verifique quantas vezes um número inteiro x é divisível por um número inteiro y. A
função deve retornar -1 caso não seja possível calcular. Escreva também um algoritmo para testar tal
função.*/

#include <stdio.h>

// Função que conta quantas vezes x é divisível por y
int quantasVezesDivisivel(int x, int y) {
    // Não é possível calcular se y for <= 1 (divisão por 0 ou loop infinito com 1)
    if (y <= 1 || x <= 0) {
        return -1;
    }

    int contador = 0;

    // Enquanto x for divisível exatamente por y (resto == 0)
    while (x % y == 0) {
        contador++; // Conta uma divisão feita
        x = x / y;  // Reduz x dividindo por y
    }

    return contador;
}

// Algoritmo de teste (main)
int main() {
    int x, y;

    printf("Digite x e y: ");
    scanf("%d %d", &x, &y);

    int resultado = quantasVezesDivisivel(x, y);

    if (resultado == -1) {
        printf("Nao foi possivel calcular.\n");
    } else {
        printf("Divisivel %d vez(es).\n", resultado);
    }

    return 0;
}
