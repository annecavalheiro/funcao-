/ 106. Faça um procedimento que receba, por parâmetro, duas matrizes A(4,6) e B(6,4) e retorna uma matriz
C, também por parâmetro, que seja a diferença de M com N. */

#include <stdio.h>

// Procedimento que calcula C = A - (transposta de B)
// A(4,6), B(6,4) e C(4,6)
void diferencaMatrizesComTransposta(int A[4][6], int B[6][4], int C[4][6]) {
    // Processamento: subtrai de A[i][j] o elemento transposto B[j][i]
    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 6; j++) {
            C[i][j] = A[i][j] - B[j][i];
        }
    }
}

// Procedimento auxiliar para exibir uma matriz 4x6
void exibirMatriz(int M[4][6]) {
    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 6; j++) {
            printf("%d\t", M[i][j]);
        }
        printf("\n");
    }
}

int main() {
    int A[4][6];
    int B[6][4];
    int C[4][6]; // C tem as dimensoes de A (4x6)

    // Entrada: preenchimento da matriz A (4x6)
    printf("--- Preenchendo a Matriz A (4x6) ---\n");
    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 6; j++) {
            printf("A[%d][%d]: ", i, j);
            scanf("%d", &A[i][j]);
        }
    }

    // Entrada: preenchimento da matriz B (6x4)
    printf("\n--- Preenchendo a Matriz B (6x4) ---\n");
    for (int i = 0; i < 6; i++) {
        for (int j = 0; j < 4; j++) {
            printf("B[%d][%d]: ", i, j);
            scanf("%d", &B[i][j]);
        }
    }

    // Chama o procedimento enviando A, B e C por parametro
    diferencaMatrizesComTransposta(A, B, C);

    // Saida: exibe a matriz C resultante (4x6)
    printf("\n--- Matriz Resultante C (4x6) [A - B^T] ---\n");
    exibirMatriz(C);

    return 0;
}
